# Copy this file to .env and fill in your values
# cp .env.example .env

# n8n Webhook URL — paste the URL shown after activating the Webhook node in n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/ats-resume-analyzer

# File upload limits
MAX_FILE_SIZE_MB=5

# FastAPI server
API_HOST=127.0.0.1
API_PORT=8000

# n8n response timeout in seconds (AI analysis can take time)
N8N_TIMEOUT_SECONDS=180
